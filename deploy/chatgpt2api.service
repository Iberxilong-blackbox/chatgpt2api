[Unit]
Description=chatgpt2api service
After=network.target postgresql@12-main.service mysql.service
Wants=network.target

[Service]
Type=simple
User=chatgpt2api
Group=chatgpt2api
WorkingDirectory=/opt/chatgpt2api
ExecStart=/opt/chatgpt2api/chatgpt2api
Restart=on-failure
RestartSec=5s

# Keep application and browser state in a writable path under the systemd sandbox.
Environment=HOME=/opt/chatgpt2api/data/home

# Chrome requires its setuid sandbox to create browser namespaces.
# Keep the systemd filesystem sandboxing below; do not disable Chrome sandbox.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Allow runtime data, relogin artifacts, and settings-page .env updates.
# Keep Nginx IP allowlists on /api/settings and /api/proxy when exposing the admin UI.
ReadWritePaths=/opt/chatgpt2api/data /opt/chatgpt2api/email-relogin/runtime /opt/chatgpt2api/email-relogin/output /opt/chatgpt2api/.env

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chatgpt2api

[Install]
WantedBy=multi-user.target
