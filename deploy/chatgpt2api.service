[Unit]
Description=chatgpt2api service
After=network.target postgresql@12-main.service mysql.service
Wants=network.target

[Service]
Type=simple
User=chatgpt2api
Group=chatgpt2api
WorkingDirectory=/opt/chatgpt2api
ExecStart=/opt/chatgpt2api/chatgpt2api
Restart=on-failure
RestartSec=5s

# 将 HOME 指向应用目录，避免 ProtectHome=yes 导致 PostgreSQL 驱动读取 ~/.postgresql 时报权限错误
Environment=HOME=/opt/chatgpt2api

# 安全加固
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Allow runtime data writes and settings-page .env updates.
# Keep Nginx IP allowlists on /api/settings and /api/proxy when exposing the admin UI.
ReadWritePaths=/opt/chatgpt2api/data /opt/chatgpt2api/.env

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chatgpt2api

[Install]
WantedBy=multi-user.target
